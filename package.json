{
  "name": "la-ligue",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names web,api \"vite\" \"npm run api\"",
    "api": "json-server --host 127.0.0.1 src/db.json",
    "build": "vite build",
    "preview": "concurrently --kill-others --names web,api \"vite preview\" \"npm run api\"",
    "format": "prettier . --write"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "json-server": "^1.0.0-beta.15",
    "prettier": "^3.9.9",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^10.0.5",
    "vite": "^6.0.7"
  }
}
